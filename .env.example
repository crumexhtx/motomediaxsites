# Canonical site origin used for metadata, sitemap, and JSON-LD.
# Use your production domain in production; set preview URLs on Vercel previews.
NEXT_PUBLIC_SITE_URL=https://www.motomediax.com

# Auto.dev API key for offline catalog enrichment (pnpm enrich:autodev).
# Server/scripts only — never expose in client code. Get a key at https://www.auto.dev/
AUTODEVAPI=

# YouTube Data API v3 key for offline video enrichment (python scripts/fetch-toyota-videos.py).
# Server/scripts only — never expose in client code. Alias YOUTUBEKEY also works.
YOUTUBE_API_KEY=

# Optional Edmunds affiliate / tracking id for year-page valuation CTAs.
# Edmunds affiliate program is available via CJ Affiliate / FlexOffers — join
# before setting this. Public appraisal links work without it.
NEXT_PUBLIC_EDMUNDS_AFFILIATE_ID=

# Same AUTODEVAPI key powers optional used-price averages:
#   pnpm enrich:pricing
# Writes src/data/pricing-overrides.json (listing medians). Without overrides,
# year pages show a labeled retention estimate vs curated starting MSRP.
